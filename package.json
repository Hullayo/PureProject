{
  "name": "projectmanager",
  "version": "1.2.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/fix-tauri-assets.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:acl": "node scripts/check-android-acl.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "git:status": "git status --short --branch",
    "git:history": "git log --graph --decorate --oneline --all -20",
    "git:save": "node scripts/git-save.mjs",
    "verify": "pnpm check && pnpm check:i18n && pnpm check:acl && pnpm test",
    "test": "pnpm test:data && pnpm test:sync-schema && pnpm test:recurrence && pnpm test:reorder && pnpm test:plugins && pnpm test:live-duration && pnpm test:rust",
    "test:reorder": "node --experimental-strip-types scripts/test-reorder.mjs",
    "test:plugins": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/test-plugins.mjs",
    "test:live-duration": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/test-live-duration.mjs",
    "test:recurrence": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/test-recurrence.mjs",
    "test:data": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/test-data-safety.mjs",
    "test:sync-schema": "node scripts/test-sync-schema.mjs",
    "test:rust": "node scripts/test-rust-atomic.mjs",
    "test:e2e-drag": "node scripts/e2e-drag.mjs",
    "test:e2e-data": "node scripts/e2e-data.mjs",
    "test:e2e-theme": "node scripts/e2e-theme.mjs",
    "test:e2e-recurrence": "node scripts/e2e-recurrence.mjs",
    "tauri": "tauri",
    "icons": "tauri icon static/icon-manifest.json --ios-color \"#a33b32\"",
    "build:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "build:android": "pnpm icons && tauri android build --apk",
    "publish:update": "node scripts/publish-update.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "docs": "node scripts/generate-docs.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xyflow/svelte": "^1.6.2",
    "openai": "^6.39.1",
    "tauri-plugin-android-fs-api": "29.0.0",
    "tauri-plugin-android-installer-api": "^0.1.0",
    "vditor": "^3.11.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.2",
    "sharp": "^0.34.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
